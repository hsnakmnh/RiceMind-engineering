#!/usr/bin/env bash
# Copy to configs/keyword-filtered.env.sh; select through RICEMIND_ENV_FILE.
_RICEMIND_PROJECT_ROOT="$(cd "$(dirname "$BASH_SOURCE")/.." && pwd)"
source "$_RICEMIND_PROJECT_ROOT/ricemind_env.sh"
export RICEMIND_CORPUS_DIR="$_RICEMIND_PROJECT_ROOT/results/corpora/current"
export RICEMIND_SENTENCE_DIR="$RICEMIND_CORPUS_DIR/annual"
export RICEMIND_RESULTS_DIR="$_RICEMIND_PROJECT_ROOT/results/runs/keyword_filtered"
export RICEMIND_OGER_OUTPUT_DIR="$RICEMIND_RESULTS_DIR/oger"
export RICEMIND_SCISPACY_OUTPUT_ROOT="$RICEMIND_RESULTS_DIR/scispacy"
export RICEMIND_PHRASE_OUTPUT_ROOT="$RICEMIND_RESULTS_DIR/phrase"
export RICEMIND_CLEANED_OUTPUT_ROOT="$RICEMIND_RESULTS_DIR/cleaned"
unset _RICEMIND_PROJECT_ROOT

