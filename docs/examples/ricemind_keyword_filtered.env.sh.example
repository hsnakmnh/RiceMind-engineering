#!/usr/bin/env bash
# Copy to <repo>/configs/keyword_filtered.env.sh before use.
# Only for annotation of keyword-filtered sentences; use base config for prepare.
_RICEMIND_PROFILE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -f "$_RICEMIND_PROFILE_ROOT/ricemind_env.sh" ]]; then
    echo "[ERROR] Base config missing. Copy this example to <repo>/configs/." >&2
    return 2
fi
source "$_RICEMIND_PROFILE_ROOT/ricemind_env.sh"
export RICEMIND_ANNOTATION_DICT_DIR="$RICEMIND_BASE_DIR/dict-dir/annotation"
export RICEMIND_CO_DICT="$RICEMIND_ANNOTATION_DICT_DIR/co-dict.tsv"
export RICEMIND_GO_DICT="$RICEMIND_ANNOTATION_DICT_DIR/go-dict.tsv"
export RICEMIND_TO_DICT="$RICEMIND_ANNOTATION_DICT_DIR/to-dict.tsv"
export RICEMIND_RTO_DICT="$RICEMIND_ANNOTATION_DICT_DIR/rto-dict.tsv"
export RICEMIND_VARIETY_DICT="$RICEMIND_ANNOTATION_DICT_DIR/variety-dict.tsv"
export RICEMIND_OGER_DICT_DIR="$RICEMIND_BASE_DIR/dict-dir/oger"
export RICEMIND_OGER_GENE_DIR="$RICEMIND_OGER_DICT_DIR/genes"
export RICEMIND_OGER_ONTOLOGY_DIR="$RICEMIND_OGER_DICT_DIR/ontology"
export RICEMIND_NOISE_BLACKLIST_DIR="$RICEMIND_BASE_DIR/dict-dir/filtering/blacklists"
unset RICEMIND_NOISE_BLACKLIST_FILE
export RICEMIND_SENTENCE_DIR="$RICEMIND_RESULTS_DIR/sentence_keyword_filtered"
export RICEMIND_SCISPACY_OUTPUT_ROOT="$RICEMIND_RESULTS_DIR/scispacy/keyword_filtered"
export RICEMIND_PHRASE_OUTPUT_ROOT="$RICEMIND_RESULTS_DIR/phrase/keyword_filtered"
unset _RICEMIND_PROFILE_ROOT
